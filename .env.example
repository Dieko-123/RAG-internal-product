# Frontend values for local Vite development and Cloudflare Pages.
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Convex deployment selection for local development.
CONVEX_DEPLOYMENT=

# Convex environment variables. Set these in Convex, not in frontend code.
CLERK_JWT_ISSUER_DOMAIN=
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# Optional: cheaper model for chat title generation (defaults to gemini-2.5-flash-lite)
CHAT_TITLE_MODEL=
APP_ADMIN_EMAILS=your_admin_email@example.com
APP_ADMIN_TOKEN_IDENTIFIERS=
APP_ALLOWED_EMAILS=
APP_ALLOWED_EMAIL_DOMAINS=
MONTHLY_BUDGET_USD=
